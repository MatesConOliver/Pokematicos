  const today = todayISODate();
  const viewCfg = streakConfigs.find((c) => c.id === viewStreakId) || null;

  const allSelected = students.length > 0 && selectedIds.length === students.length;

  function toggleStudent(id) {
    setSelectedIds((prev) =>
