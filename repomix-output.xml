          >
            {allEligibleSelected ? "Deselect all" : "Select all"}
          </button>
          <div className="muted">{selectedStudentIds.length} selected</div>
        </div>

        <div
          style={{
            marginTop: 12,
            maxHeight: 320,
            overflow: "auto",
            border: "1px solid #eee",
            borderRadius: 12,
            padding: 10,
            background: "#fff",
          }}
        >
          {students.map((student) => {
            const unlocked = isCardUnlockedForStudent(student, card);
            return (
              <label
                key={student.id}
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: 10,
                  padding: "8px 6px",
                  borderBottom: "1px solid #f2f2f2",
                  opacity: unlocked ? 1 : 0.55,
                  cursor: unlocked ? "pointer" : "not-allowed",
                }}
              >
                <input
                  type="checkbox"
                  disabled={!unlocked}
                  checked={selectedStudentIds.includes(student.id)}
                  onChange={() => unlocked && onToggleStudent(student.id)}
                />
                <span style={{ fontWeight: 800 }}>{student.name}</span>
                {!unlocked && (
                  <span
                    style={{
                      fontSize: 11,
                      padding: "1px 6px",
                      borderRadius: 999,
                      background: "#fee2e2",
                      color: "#b91c1c",
                      fontWeight: 700,
                    }}
                  >
                    🔒 Evolución bloqueada
                  </span>
                )}
                <span className="muted" style={{ marginLeft: "auto" }}>
                  x{typeof student.multiplier === "number" ? student.multiplier : 1}
                </span>
              </label>
            );
          })}
          {students.length === 0 && <div className="muted">No students in this class yet.</div>}
        </div>

        <div style={{ marginTop: 12, display: "flex", gap: 8, flexWrap: "wrap" }}>
          <button className="btn" onClick={onClose}>
            Cancel
          </button>
          <button
            className="btn primary"
            disabled={selectedStudentIds.length === 0}
            onClick={onGive}
          >
            Give to selected
          </button>
        </div>
      </div>
    </div>
  );
}
