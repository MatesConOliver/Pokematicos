export default function NoticeBoardPanel({
  mode,
  students = [],
  cards = [],
  rewards = [],
  streakConfigs = [],
  newsMessages = [],
  flagValue = "A",
  onSaveNewsMessages,
  confirmFn,
  onValidationError,
}) {
  const isAdmin = mode === "admin";
  const [showComposer, setShowComposer] = useState(false);
  const [title, setTitle] = useState("");
  const [text, setText] = useState("");
  const [pinned, setPinned] = useState(false);
  const [posting, setPosting] = useState(false);

  const { pinnedItems, items, todayItems, olderItems } = useMemo(
    () =>
      buildNoticeBoardData({
        students,
        cards,
        rewards,
        streakConfigs,
        newsMessages,
        flagValue,
      }),
    [students, cards, rewards, streakConfigs, newsMessages, flagValue]
  );

  const handleCreateMessage = async (e) => {
    e.preventDefault();
    const cleanTitle = title.trim();
    const cleanText = text.trim();
    if (!cleanTitle && !cleanText) {
      onValidationError?.("Enter a title or message text.");
      return;
    }

    const nextMsg = {
      id: uid("news"),
      title: cleanTitle,
      text: cleanText,
      pinned,
      createdAt: Date.now(),
    };

    const nextList = [nextMsg, ...(Array.isArray(newsMessages) ? newsMessages : [])];
    setPosting(true);
    const ok = await onSaveNewsMessages?.(nextList);
    setPosting(false);

    if (ok !== false) {
      setTitle("");
      setText("");
      setPinned(false);
      setShowComposer(false);
    }
  };

  const handleSaveEdit = async (messageId, updates) => {
    const current = Array.isArray(newsMessages) ? newsMessages : [];
    const nextList = current.map((m) =>
      m?.id === messageId
        ? {
            ...m,
            title: updates.title,
            text: updates.text,
            pinned: Boolean(updates.pinned),
            updatedAt: Date.now(),
          }
        : m
    );
    return onSaveNewsMessages?.(nextList);
  };

  const handleTogglePin = async (messageId) => {
    const current = Array.isArray(newsMessages) ? newsMessages : [];
    const nextList = current.map((m) =>
      m?.id === messageId
        ? {
            ...m,
            pinned: !m.pinned,
            updatedAt: Date.now(),
          }
        : m
    );
    await onSaveNewsMessages?.(nextList);
  };

  const handleDeleteMessage = async (messageId) => {
    if (confirmFn && !(await confirmFn("Delete this news message?"))) return;
    const current = Array.isArray(newsMessages) ? newsMessages : [];
    const nextList = current.filter((m) => m?.id !== messageId);
    await onSaveNewsMessages?.(nextList);
  };

  return (
    <div style={{ display: "grid", gap: 14 }}>
      {isAdmin && (
        <div style={{ display: "grid", gap: 8 }}>
          <div style={{ display: "flex", justifyContent: "flex-end" }}>
            <button
              type="button"
              className="btn"
              onClick={() => setShowComposer((prev) => !prev)}
              style={{
                background: showComposer ? "#fee2e2" : "#ffffff",
                border: "1px solid #ef4444",
                color: "#dc2626",
                fontWeight: 700,
                fontSize: 12,
                padding: "5px 10px",
              }}
            >
              {showComposer ? "✕ Cancel" : "+ Write news"}
            </button>
          </div>

          {showComposer && (
            <form
              onSubmit={handleCreateMessage}
              style={{
                padding: 12,
                borderRadius: 12,
                background: "linear-gradient(135deg, #fff1f2 0%, #fef2f2 100%)",
                border: "1.5px solid #ef4444",
                boxShadow: "0 3px 10px rgba(220, 38, 38, 0.12)",
                display: "grid",
                gap: 8,
              }}
            >
              <input
                type="text"
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder="Title (optional)"
                style={{
                  width: "100%",
                  padding: "6px 8px",
                  borderRadius: 8,
                  border: "1px solid #fca5a5",
                  fontSize: 13,
                  fontWeight: 700,
                  color: "#dc2626",
                  background: "#ffffff",
                  boxSizing: "border-box",
                }}
              />
              <textarea
                value={text}
                onChange={(e) => setText(e.target.value)}
                placeholder="Message text (optional)"
                rows={3}
                style={{
                  width: "100%",
                  padding: "6px 8px",
                  borderRadius: 8,
                  border: "1px solid #fca5a5",
                  fontSize: 12.5,
                  color: "#0f172a",
                  background: "#ffffff",
                  resize: "vertical",
                  boxSizing: "border-box",
                  fontFamily: "inherit",
                }}
              />
              <div
                style={{
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  gap: 8,
                  flexWrap: "wrap",
                }}
              >
                <label
                  style={{
                    display: "inline-flex",
                    alignItems: "center",
                    gap: 6,
                    fontSize: 12,
                    fontWeight: 700,
                    color: "#991b1b",
                    cursor: "pointer",
                  }}
                >
                  <input
                    type="checkbox"
                    checked={pinned}
                    onChange={(e) => setPinned(e.target.checked)}
                    style={{ accentColor: "#dc2626" }}
                  />
                  📌 Pin to top
                </label>
                <button
                  type="submit"
                  className="btn"
                  disabled={posting}
                  style={{
                    padding: "5px 12px",
                    fontSize: 12,
                    background: "#dc2626",
                    color: "#ffffff",
                    border: "1px solid #b91c1c",
                    fontWeight: 700,
                  }}
                >
                  {posting ? "Posting..." : "Post"}
                </button>
              </div>
            </form>
          )}
        </div>
      )}

      {items.length === 0 ? (
        <div
          style={{
            padding: 18,
            borderRadius: 14,
            background: "#ffffff",
            border: "1px solid #e2e8f0",
            textAlign: "center",
            color: "#64748b",
            fontSize: 13,
          }}
        >
          No news yet for this class.
        </div>
      ) : (
        <>
          <NoticeGroup
            heading="📌 Pinned"
            items={pinnedItems}
            isAdmin={isAdmin}
            onSaveEdit={handleSaveEdit}
            onTogglePin={handleTogglePin}
            onDelete={handleDeleteMessage}
            onValidationError={onValidationError}
          />
          <NoticeGroup
            heading="Today"
            items={todayItems}
            isAdmin={isAdmin}
            onSaveEdit={handleSaveEdit}
            onTogglePin={handleTogglePin}
            onDelete={handleDeleteMessage}
            onValidationError={onValidationError}
          />
          <NoticeGroup
            heading="Older"
            items={olderItems}
            isAdmin={isAdmin}
            onSaveEdit={handleSaveEdit}
            onTogglePin={handleTogglePin}
            onDelete={handleDeleteMessage}
            onValidationError={onValidationError}
          />
        </>
      )}
    </div>
  );
}
