                  width: "100%",
                  height: "100%",
                  objectFit: "cover",
                }}
              />
            ) : (
              <div style={{ padding: 20, textAlign: "center", color: "#fff", fontWeight: 800 }}>
                {evolvedCard?.title}
              </div>
            )}
