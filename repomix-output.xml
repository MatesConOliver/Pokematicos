import { isEvolutionCard, isCardUnlockedForStudent } from "../../services/cardEvolutionService";

export default function BulkGiveModal({
  card,
  students,
  selectedStudentIds,
  onClose,
  onToggleStudent,
  onToggleSelectAll,
