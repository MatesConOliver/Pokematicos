          borderRadius: 20,
          overflow: "hidden",
          position: "relative",
          background: "#18181b",
          boxShadow:
            stage === 2
              ? "0 0 50px rgba(234, 179, 8, 0.7), 0 0 20px rgba(255, 255, 255, 0.5)"
