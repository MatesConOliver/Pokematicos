@tailwind base;
@tailwind components;
@tailwind utilities;

/* small helpers you might like */
html, body, #root { height: 100%; }

.feedback-notice {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 1100;
  display: flex;
  align-items: center;
  gap: 14px;
  max-width: min(420px, calc(100vw - 40px));
  padding: 14px 16px;
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  color: #172033;
  font-weight: 700;
  animation: feedbackNoticeIn 180ms ease-out;
}

.feedback-dismiss {
  border: 0;
  background: transparent;
  color: #64748b;
  cursor: pointer;
  font-size: 16px;
  font-weight: 800;
}

.feedback-dialog {
  width: min(430px, calc(100vw - 32px));
  padding: 26px;
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  box-shadow: 0 24px 70px rgba(15, 23, 42, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.95);
  color: #172033;
  animation: feedbackDialogIn 180ms ease-out;
}

.feedback-dialog-icon {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 50%;
  background: #fff1d6;
  color: #a15c00;
  font-size: 20px;
  font-weight: 900;
}

.feedback-dialog h3 {
  margin: 16px 0 8px;
}

.feedback-dialog p {
  margin: 0;
  white-space: pre-line;
  color: #64748b;
  line-height: 1.5;
}

.feedback-dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 24px;
}

.level-up-dialog {
  width: min(440px, calc(100vw - 32px));
  padding: 30px 24px;
  border-radius: 24px;
  background: linear-gradient(180deg, #ffffff 0%, #fefce8 100%);
  border: 2px solid #fef08a;
  box-shadow: 0 25px 50px -12px rgba(234, 179, 8, 0.35), 0 0 0 1px rgba(234, 179, 8, 0.2);
  text-align: center;
  animation: levelUpPopIn 260ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes levelUpPopIn {
  from { opacity: 0; transform: scale(0.85) translateY(12px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.form-modal {
  max-width: 560px;
}

.form-modal > .muted {
  margin: -4px 0 18px;
}

.form-field {
  display: grid;
  gap: 6px;
  margin-top: 12px;
  color: #172033;
  font-size: 13px;
  font-weight: 800;
}

.form-check {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 16px;
  color: #172033;
  font-size: 14px;
}

.form-check input,
.reward-picker-option input {
  margin-top: 3px;
  accent-color: #2563eb;
}

.form-check span {
  display: grid;
  gap: 3px;
}

.form-check small {
  color: #64748b;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.4;
}

.reward-picker {
  margin: 20px 0 0;
  padding: 14px;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.reward-picker legend {
  padding: 0 6px;
  color: #172033;
  font-size: 13px;
  font-weight: 800;
}

.reward-picker-list {
  display: grid;
  gap: 8px;
  max-height: 220px;
  margin-top: 12px;
  overflow: auto;
